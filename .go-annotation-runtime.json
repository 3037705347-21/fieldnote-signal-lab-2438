{
  "shape": "backend",
  "service": {
    "command": "go run ./cmd/api",
    "startup_timeout_seconds": 20,
    "health": {
      "url": "http://127.0.0.1:18081/health",
      "method": "GET",
      "status": 200,
      "contains": "ok"
    },
    "api": {
      "url": "http://127.0.0.1:18081/api/v1/catalog",
      "method": "GET",
      "status": 200,
      "contains": "habitat"
    }
  },
  "workflow_checks": [
    {
      "workflow_id": "capture-observation",
      "url": "http://127.0.0.1:18081/api/v1/observations/demo-001",
      "method": "GET",
      "status": 200,
      "contains": "demo-001"
    },
    {
      "workflow_id": "label-observation",
      "url": "http://127.0.0.1:18081/api/v1/observations/demo-001",
      "method": "GET",
      "status": 200,
      "contains": "habitat"
    },
    {
      "workflow_id": "review-signal",
      "url": "http://127.0.0.1:18081/api/v1/observations/demo-001/report",
      "method": "GET",
      "status": 200,
      "contains": "score"
    }
  ]
}
